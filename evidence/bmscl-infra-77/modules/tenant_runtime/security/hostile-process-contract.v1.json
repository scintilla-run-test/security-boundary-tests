{
  "schema_version": 1,
  "execution_class": "hostile-bare-process",
  "tenant_boundary": "one-tenant-per-beam-vm",
  "isolation_profile": "tenant-worker",
  "trusted_authorities": {
    "demand_observation": "host-control-plane",
    "process_identity": "host-runtime-record",
    "isolation_admission": "host-agent",
    "lifecycle_fencing": "ores-locks-and-leases",
    "placement_epoch": "host-scheduler"
  },
  "cooperative_runtime_signals": [
    "quiesce",
    "drain_acknowledgement",
    "resume"
  ],
  "required_process_evidence": {
    "no_new_privs": true,
    "zero_capability_sets": [
      "inheritable",
      "permitted",
      "effective",
      "bounding",
      "ambient"
    ],
    "namespaces_distinct_from_host": [
      "user",
      "mount",
      "pid",
      "ipc",
      "uts",
      "cgroup",
      "network"
    ],
    "bind_process_start_identity": true,
    "bind_managed_cgroup": true,
    "bind_runtime_epoch": true,
    "bind_placement_epoch": true,
    "bind_isolation_policy_digest": true
  },
  "network": {
    "mode": "external",
    "deny_host_loopback": true,
    "deny_private_networks": true,
    "deny_link_local": true,
    "deny_ec2_imds_ipv4": "169.254.169.254/32",
    "deny_ec2_imds_ipv6": "fd00:ec2::254/128"
  },
  "filesystem": {
    "forbid_broad_host_mounts": [
      "/",
      "/opt",
      "/run",
      "/bin",
      "/sbin",
      "/usr/bin",
      "/usr/sbin"
    ],
    "required_read_only_mounts": [
      "/opt/beamscale/honeypot-bin",
      "/run/bmscl-honeypot/tripwire.sock"
    ],
    "tenant_path": "/opt/beamscale/honeypot-bin"
  },
  "lifecycle": {
    "controller_must_be_outside_managed_cgroup": true,
    "recheck_trusted_demand_after_fence": true,
    "recheck_trusted_demand_after_cooperative_quiesce": true,
    "require_host_admission_after_thaw_or_restore": true,
    "mutation_target": "managed-cgroup-plus-process-start-identity",
    "mutation_identity_components": [
      "logical_workload_id",
      "runtime_epoch",
      "placement_epoch",
      "process_start_identity",
      "managed_cgroup",
      "isolation_policy_digest",
      "fencing_token"
    ],
    "freeze_intent_state": "freezing",
    "frozen_state": "frozen",
    "thaw_intent_state": "thawing",
    "running_state": "running",
    "freeze_requires_persisted_intent_before_effect": true,
    "thaw_requires_persisted_intent_before_effect": true,
    "running_requires_post_wake_host_admission": true,
    "bootstrap_lock_provider": "cloudflare-durable-objects-via-ores-locks-and-leases",
    "beamscale_native_lock_required_for_bootstrap": false,
    "lease_key_shape": "process-lifecycle/beamscale/<cluster>/<workload>",
    "generic_host_effects": [
      "freeze",
      "thaw"
    ],
    "generic_hibernate_authority": false,
    "checkpoint_restore_authority": "separately-reviewed-typed-adapter",
    "tenant_supplied_process_target_allowed": false,
    "product_socket_role": "cooperative-evidence-only"
  },
  "stronger_isolation_class": "firecracker"
}
